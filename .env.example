# Local development
APP_ENV=local
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///instance/placeprep.db
COOKIE_SECURE=0

# AWS production
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@RDS-ENDPOINT:5432/placeprep
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-placeprep-private-bucket
AWS_S3_PREFIX=placeprep
AWS_S3_PRESIGNED_SECONDS=900
AWS_CLOUDWATCH_ENABLED=1
# On Elastic Beanstalk, prefer an IAM instance/service role instead of hard-coding AWS keys.
